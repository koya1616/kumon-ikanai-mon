{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kumon-ikanai-mon",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-16",
  // 2026-08-04 以降の日付では nodejs_compat 系はデフォルト有効のため flags 不要
  "observability": { "enabled": true },
  // フロントエンドの CSS / JS は文字列として bundle し、view.ts で HTML に埋め込む
  "rules": [{ "type": "Text", "globs": ["**/*.css", "**/*.client.js"], "fallthrough": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kumon-ikanai-mon-db",
      "database_id": "3f9ee445-7ea2-4edd-a1ed-62567300891f",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {},
}
